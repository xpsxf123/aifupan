<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jiuyu.governance.business.org.mapper.TeamMapper">
  <resultMap id="BaseResultMap" type="com.jiuyu.governance.business.org.pojo.entity.Team">
    <!--@mbg.generated-->
    <!--@Table team-->
    <id column="id" jdbcType="BIGINT" property="id" />
    <result column="tenant_id" jdbcType="BIGINT" property="tenantId" />
    <result column="name" jdbcType="VARCHAR" property="name" />
    <result column="dept_id" jdbcType="BIGINT" property="deptId" />
    <result column="create_date" jdbcType="TIMESTAMP" property="createDate" />
    <result column="update_date" jdbcType="TIMESTAMP" property="updateDate" />
    <result column="create_by" jdbcType="BIGINT" property="createBy" />
    <result column="update_by" jdbcType="BIGINT" property="updateBy" />
    <result column="sort" jdbcType="INTEGER" property="sort" />
    <result column="is_deleted" jdbcType="BOOLEAN" property="isDeleted" />
    <result column="company_id" jdbcType="BIGINT" property="companyId" />
  </resultMap>
  <sql id="Base_Column_List">
    <!--@mbg.generated-->
    id, tenant_id, `name`, dept_id, create_date, update_date, create_by, update_by, sort,
    is_deleted, company_id
  </sql>
  
  <select id="pageQueryTeam" resultMap="BaseResultMap">
      select a.* from team as a
      <if test="req.currentUserId != null">
          <if test="req.deptIds != null and req.deptIds.size() != 0">
              left
          </if>
          join manager_connector as b on a.id = b.target_id and b.manager_type = 3 and b.is_deleted = 0 and b.employee_id = #{req.currentUserId}
      </if>
      where a.is_deleted = 0
        and a.tenant_id = #{req.tenantId}
      <if test="req.name != null and req.name != ''">
          and a.name like concat('%', #{req.name}, '%')
      </if>
      <if test="req.deptId != null">
          and a.dept_id = #{req.deptId}
      </if>
      <if test="req.companyId != null">
          and a.company_id = #{req.companyId}
      </if>
      <if test="(req.deptIds != null and req.deptIds.size() != 0) or req.currentUserId != null">
          and (
          <if test="req.currentUserId != null">
              b.employee_id = #{req.currentUserId}
          </if>
          <if test="req.deptIds != null and req.deptIds.size() != 0">
              <if test="req.currentUserId != null">
                  or
              </if>
              a.dept_id in
              <foreach item="item" index="index" collection="req.deptIds" open="(" separator="," close=")">
                  #{item}
              </foreach>
          </if>
          )
      </if>
      order by a.sort
  </select>
  
  <select id="listQueryTeam" resultMap="BaseResultMap">
      select a.* from team as a
      <if test="req.currentUserId != null">
          <if test="req.deptIds != null and req.deptIds.size() != 0">
              left
          </if>
          join manager_connector as b on a.id = b.target_id and b.manager_type = 3 and b.is_deleted = 0 and
                                         b.employee_id = #{req.currentUserId}
      </if>
      where a.is_deleted = 0
        and a.tenant_id = #{req.tenantId}
      <if test="req.deptId != null">
          and a.dept_id = #{req.deptId}
      </if>
      <if test="req.excludeIds != null and req.excludeIds.size() != 0">
          and a.id not in
          <foreach item="item" index="index" collection="req.excludeIds" open="(" separator="," close=")">
              #{item}
          </foreach>
      </if>
      <if test="req.keyword != null and req.keyword != ''">
          and a.name like concat('%', #{req.keyword}, '%')
      </if>
      <if test="(req.deptIds != null and req.deptIds.size() != 0) or req.currentUserId != null">
          and (
          <if test="req.currentUserId != null">
              b.employee_id = #{req.currentUserId}
          </if>
          <if test="req.deptIds != null and req.deptIds.size() != 0">
              <if test="req.currentUserId != null">
                  or
              </if>
              a.dept_id in
              <foreach item="item" index="index" collection="req.deptIds" open="(" separator="," close=")">
                  #{item}
              </foreach>
          </if>
          )
      </if>
      limit #{req.limit}
  </select>
</mapper>
