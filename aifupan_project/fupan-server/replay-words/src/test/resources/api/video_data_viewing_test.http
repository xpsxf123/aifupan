# );

# -- 插入无效本段数据（data_status = 2 表示拉取失败）
# INSERT INTO tb_video_data_viewing_paragraph (
#     id, video_id, user_id, tenant_id, data_viewing_confuse_id,
#     data_status, total_watch_num, create_date, update_date, is_deleted
# ) VALUES (
#     1234567890123456802, 'test_video_id_002', 1, 1, 1002,
#     2, 0, NOW(), NOW(), 0
# );

# -- 查询本段数据
# SELECT id, video_id, data_status, total_watch_num
# FROM tb_video_data_viewing_paragraph
# WHERE video_id IN ('test_video_id_001', 'test_video_id_002');

# -- 清理测试数据
# DELETE FROM tb_video_data_viewing_paragraph WHERE video_id LIKE 'test_video_id_%';

