<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jiuyu.replay.power.repository.dao.UserTokenDao">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.jiuyu.replay.power.entity.UserTokenEntity">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="token" property="token"/>
        <result column="user_info" property="userInfo"/>
        <result column="expire_time" property="expireTime"/>
        <result column="last_access_time" property="lastAccessTime"/>
        <result column="create_date" property="createDate"/>
        <result column="update_date" property="updateDate"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id
        , user_id, token, user_info, expire_time, last_access_time, create_date, update_date, is_deleted
    </sql>

    <!-- 更新过期时间 -->
    <update id="updateUserTokenExpireTimeByToken">
        UPDATE tb_user_token
        SET last_access_time = NOW(),
        update_date = NOW()
        <if test="expireTime != null">
            ,expire_time = #{expireTime}
        </if>
        WHERE token = #{token}
        AND is_deleted = 0
    </update>

</mapper>
