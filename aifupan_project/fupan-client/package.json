{
  "name": "bh-manage-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "version": "node scripts/updateWebVersion.js",
    "version:create": "node scripts/versioning/createVersion.js",
    "version:index": "node scripts/versioning/rebuildVersionIndex.js",
    "qa:log": "node scripts/qa-memory/logQa.js",
    "qa:reset": "node scripts/qa-memory/logQa.js --reset",
    "hooks:install": "node scripts/git-hooks/install.js",
    "files:index": "node scripts/file-registry/rebuild.js",
    "serve": "cross-env RUN_ENV=development vue-cli-service serve",
    "serve:custom": "cross-env RUN_ENV=custom vue-cli-service serve",
    "serve:release": "cross-env RUN_ENV=release vue-cli-service serve",
    "serve:prod": "cross-env RUN_ENV=production vue-cli-service serve",
    "serve:release:web": "cross-env RUN_ENV=release BUILD_TARGET=website vue-cli-service serve",
    "serve:web": "cross-env RUN_ENV=development BUILD_TARGET=website vue-cli-service serve",
    "serve:test": "cross-env RUN_ENV=test vue-cli-service serve",
    "build:web-test": "cross-env RUN_ENV=test BUILD_TARGET=website vue-cli-service build --mode development",
    "build:test:web": "cross-env RUN_ENV=test BUILD_TARGET=website vue-cli-service build --mode development",
    "build:test": "cross-env RUN_ENV=test vue-cli-service build --mode development",
    "build:release": "cross-env RUN_ENV=release vue-cli-service build --mode production",
    "build:release:web": "cross-env RUN_ENV=release BUILD_TARGET=website vue-cli-service build --mode production",
    "build": "cross-env RUN_ENV=production vue-cli-service build",
    "build:web": "cross-env RUN_ENV=production BUILD_TARGET=website vue-cli-service build",
    "build:production": "cross-env RUN_ENV=production vue-cli-service build --mode production",
    "mock": "node ./mockjs/server.js",
    "mock:3001": "cross-env MOCK_PORT=3001 node ./mockjs/server.js"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^4.6.2",
    "@floating-ui/core": "1.6.9",
    "@floating-ui/dom": "1.6.13",
    "@floating-ui/vue": "1.1.6",
    "axios": "^0.27.2",
    "bignumber.js": "^9.1.2",
    "child_process": "^1.0.2",
    "clean-webpack-plugin": "^4.0.0",
    "core-js": "^3.6.5",
    "crypto-js": "^4.2.0",
    "docx": "^9.5.1",
    "echarts": "^5.4.1",
    "element-ui": "^2.15.10",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "less": "^4.1.3",
    "less-loader": "^6.0.0",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "mux.js": "^6.3.0",
    "qrcode": "^1.5.4",
    "shepherd.js": "14.3.0",
    "swiper": "^5.4.5",
    "tesseract.js": "^5.0.1",
    "video.js": "^8.22.0",
    "vod-js-sdk-v6": "^1.7.1-beta.1",
    "vue": "^2.6.11",
    "vue-contextmenujs": "^1.4.11",
    "vue-json-excel": "^0.3.0",
    "vue-router": "^3.2.0",
    "vuedraggable": "^2.24.3",
    "vuex": "^3.4.0",
    "vuex-persistedstate": "^4.1.0",
    "wangeditor": "^4.7.15",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@vue/cli-plugin-babel": "~4.5.15",
    "@vue/cli-plugin-router": "~4.5.15",
    "@vue/cli-plugin-vuex": "~4.5.15",
    "@vue/cli-service": "~4.5.15",
    "cross-env": "^7.0.3",
    "mockjs": "^1.1.0",
    "sass": "^1.93.3",
    "sass-loader": "^8.0.2",
    "vue-template-compiler": "^2.6.11"
  }
}
